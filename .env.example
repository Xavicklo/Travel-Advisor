# Copy this file to .env and fill in your own keys. .env is git-ignored.

# Google Maps Platform: enable "Maps JavaScript API" and "Places API".
# Restrict the key to HTTP referrers (e.g. http://localhost:3000/*, https://your-site/*).
REACT_APP_GOOGLE_MAPS_API_KEY=

# RapidAPI: subscribe to "Travel Advisor" (apidojo) at https://rapidapi.com/apidojo/api/travel-advisor
REACT_APP_RAPIDAPI_KEY=
